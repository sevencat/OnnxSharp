#version 450
// P1-4 冒烟 shader：只用来验证「shader 工具链 → EmbeddedResource → VkShaders.Load →
// vkCreateComputePipelines → vkCmdDispatch」这条链路端到端通，不参与推理。
// 接口刻意覆盖 P1-5 模板的三要素：N 个 storage buffer + push constant + 边界判断。
layout(local_size_x = 64) in;

layout(binding = 0) readonly buffer A { float a[]; };
layout(binding = 1) writeonly buffer B { float b[]; };

layout(push_constant) uniform Params {
    uint n;    // 元素个数
    float mul; // 乘子
    float add; // 加数
} p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    b[i] = a[i] * p.mul + p.add;
}
