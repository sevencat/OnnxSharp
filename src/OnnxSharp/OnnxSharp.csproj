<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OnnxSharp</RootNamespace>
    <AssemblyName>OnnxSharp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Sevencat.OnnxSharp</PackageId>
    <Version>0.0.1</Version>
    <Authors>Sevencat</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试与命令行工具需要访问 internal 的 protobuf/importer 细节，避免为工具扩大公开 API -->
    <InternalsVisibleTo Include="OnnxSharp.Tests" />
    <InternalsVisibleTo Include="OnnxSharp.Cli" />
  </ItemGroup>

</Project>
