<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 测试运行器覆盖两套运行时；产品库目标见 src/OnnxSharp/OnnxSharp.csproj -->
    <!-- net11.0 覆盖 AvxVnni 整数内核（net10.0 走 F32 展开，两套都要有测试） -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OnnxSharp.Tests</RootNamespace>
    <AssemblyName>OnnxSharp.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OnnxSharp\OnnxSharp.csproj" />
  </ItemGroup>

</Project>
